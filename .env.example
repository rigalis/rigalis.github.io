# Last.fm — FREE, no Premium, rigalis cassette widget src/components/SpotifyWidgets.tsx:1
# Get free key at https://www.last.fm/api/account/create → API Key
PUBLIC_LASTFM_API_KEY=your_api_key_here
PUBLIC_LASTFM_USER=zneq
# ListenBrainz alt (fully open, no key for public): https://listenbrainz.org/user/zneq
# FALLBACK_URL=https://www.last.fm/user/zneq

# GitHub — build-time only (scripts/fetch-github.mjs), never shipped to the browser.
# Classic PAT with `read:user` so private contributions are counted.
# Optional: without it the script falls back to the public calendar.
# Add the same value as repo secret GH_STATS_TOKEN for CI.
GH_STATS_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx
GH_USERNAME=rigalis
