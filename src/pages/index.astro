---
import Layout from '@/layouts/Layout.astro'
import GitGraph from '@/components/GitGraph.tsx'
import TechStack from '@/components/TechStack.tsx'
import SpotifyWidgets from '@/components/SpotifyWidgets.tsx'
import ProjectFlex from '@/components/ProjectFlex.tsx'
import MapWidget from '@/components/MapWidget.tsx'
import HeroCanvas from '@/components/HeroCanvas.tsx'
import NewsParticles from '@/components/NewsParticles.tsx'
import { blogPosts } from '@/data/blog'

const latestPost = blogPosts[0]
---

<Layout title="Home">
  <div id="home-stack" class="flex flex-col gap-[10px] animate-fade-in">
    <h1 class="sr-only">Rigalis — Parth Patel, systems and security researcher</h1>

    <!-- 1 · HERO — phone: empty gif banner, info stacked below, no overlap.
         Desktop: original overlay look untouched (md:absolute overlay). -->
    <section class="relative w-full overflow-hidden flex flex-col gap-[10px] md:justify-end md:min-h-[410px] md:p-5 md:gap-[10px] p-0" style="border: none; border-radius: 12px; overflow: hidden;" aria-label="Intro">
      <!-- gif banner: empty on phone -->
      <div class="relative w-full h-[30vh] min-h-[224px] max-h-[320px] shrink-0 overflow-hidden md:absolute md:inset-0 md:h-full md:max-h-none md:min-h-0">
        <style>.hero-gif{object-position:center 28%} @media (min-width:768px){.hero-gif{object-position:center 62%}}</style>
        <img src="/images/pixellay.gif" alt="Pixel lay animation" class="hero-gif absolute inset-0 w-full h-full object-cover select-none pointer-events-none" style="opacity: 1;" />
        <!-- phone fade into background so the cut looks intentional -->
        <div class="absolute inset-0 pointer-events-none md:hidden" style="background: linear-gradient(to bottom, transparent 55%, var(--background) 100%);"></div>
        <!-- desktop fade (original) -->
        <div class="absolute inset-0 pointer-events-none hidden md:block" style="background: linear-gradient(to bottom, transparent 38%, color-mix(in srgb, var(--background) 42%, transparent) 70%, var(--background) 94%);"></div>
        <div class="absolute inset-0 pointer-events-none opacity-20 hidden">
          <HeroCanvas client:load />
        </div>
      </div>

      <!-- 2 · INFO — phone: free-flowing text (no box); desktop: original glass overlay -->
      <div class="relative z-10 px-0 md:px-0 order-2">
        <style>.hero-intro{background:transparent !important;border-color:transparent !important;backdrop-filter:none !important;-webkit-backdrop-filter:none !important;box-shadow:none !important;padding:6px 2px 2px !important;border-radius:0 !important} @media (min-width:768px){.hero-intro{background:rgba(16, 28, 24, 0.66) !important;backdrop-filter:blur(10px) saturate(1.15) !important;-webkit-backdrop-filter:blur(10px) saturate(1.15) !important;padding:1rem !important;border-radius:10px !important}}</style>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-[10px]">
          <div class="hero-intro bento lg:col-span-8 p-4 flex flex-col gap-2" style="background: rgba(16, 28, 24, 0.66); backdrop-filter: blur(10px) saturate(1.15); -webkit-backdrop-filter: blur(10px) saturate(1.15); isolation: isolate; transform: translateZ(0);">
            <div class="font-sans text-[14px] leading-relaxed space-y-1" style="color: var(--muted-foreground);">
              <p><strong style="color: var(--foreground);">Hi, I&apos;m <span style="text-decoration: underline; text-underline-offset: 3px;">Parth</span></strong> <span style="font-style: italic; font-weight: 400; color: var(--muted-foreground);">aka </span><span class="rigalis-gradient" style="font-style: italic; font-weight: 600; background: linear-gradient(90deg, #FFF5DD 0%, #e8e0c8 25%, #c9c2b3 50%, #f5ecd8 75%, #FFF5DD 100%); background-size: 200% auto; -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; animation: rigalis-gradient 2.8s linear infinite;">rigalis</span><span style="font-style: italic; font-weight: 400; color: var(--muted-foreground);">,</span> I&apos;m into low-level systems, compilers, hardware. I enjoy playing CTFs (@THEM?!) and I&apos;m involved in security research.</p>
              <p>Outside tech, I design stuff, listen to music especially DnB, and game.</p>
              <p>Read more about me <a href="/about" class="underline underline-offset-2 hover:opacity-80 transition-opacity" style="color: var(--foreground); text-decoration: underline;">here</a> :D</p>
            </div>
            <style>
              @keyframes rigalis-gradient{0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%}}
            </style>
          </div>
        </div>
      </div>

      <!-- News — desktop only, exactly the original top-right pop -->
      <div class="hidden lg:block lg:absolute lg:top-5 lg:right-5 lg:w-[220px] z-20">
        <div class="bento p-3 flex flex-col relative overflow-hidden" style="background: rgba(16, 28, 24, 0.66); backdrop-filter: blur(10px) saturate(1.15); -webkit-backdrop-filter: blur(10px) saturate(1.15); isolation: isolate; transform: translateZ(0); box-shadow: 0 4px 24px rgba(0,0,0,0.35), 0 0 0 1px rgba(255,245,221,0.08);">
          <span class="absolute -top-1.5 -right-1.5 w-3 h-3 rounded-full z-20" style="background: var(--accent); border: 2px solid var(--background); box-shadow: 0 0 8px color-mix(in srgb, var(--accent) 60%, transparent);" aria-hidden="true"></span>
          <div class="news-scroll relative z-10 space-y-2 font-sans text-[12.5px] leading-relaxed" style="font-family: var(--font-sans);">
            <div class="flex justify-between gap-2 font-medium" style="color: var(--foreground);"><span class="flex items-center gap-1.5"><span class="w-1 h-1 rounded-full shrink-0" style="background: var(--foreground);"></span><span><span class="font-mono" style="font-size: 10px; letter-spacing: 0.04em; color: var(--muted-foreground);">[THEM?!]</span> 07CTF&apos;26 2nd Place [Human Div]!</span></span><span style="color: var(--muted-foreground);" class="font-normal">Sep</span></div>
            <div class="flex justify-between gap-2 font-medium" style="color: var(--foreground);"><span class="flex items-center gap-1.5"><span class="w-1 h-1 rounded-full shrink-0" style="background: var(--foreground);"></span><span><span class="font-mono" style="font-size: 10px; letter-spacing: 0.04em; color: var(--muted-foreground);">[THEM?!]</span> Qualified for z0d1ak CTF finals!</span></span><span style="color: var(--muted-foreground);" class="font-normal">Aug</span></div>
            <div class="flex justify-between gap-2 font-medium" style="color: var(--foreground);"><span class="flex items-center gap-1.5"><span class="w-1 h-1 rounded-full shrink-0" style="background: var(--foreground);"></span><span><span class="font-mono" style="font-size: 10px; letter-spacing: 0.04em; color: var(--muted-foreground);">[DJS ARYA]</span> AIR 1, Global Rank 10 @AAS International Cansat Competition</span></span><span style="color: var(--muted-foreground);" class="font-normal">Jul</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Row 2 wrapper — contents on phone so github/blog can be ordered globally; grid on desktop -->
    <div class="contents lg:grid lg:grid-cols-12 lg:gap-[10px] lg:items-stretch">
      <!-- 6 · GITHUB — full-year tiny cells on phone, above projects -->
      <div class="order-6 lg:order-none lg:col-span-7 flex flex-col min-w-0">
        <p class="lg:hidden font-mono text-[11px] mb-2 tracking-wide" style="color: var(--muted-foreground);">GitHub Activity</p>
        <GitGraph client:visible />
      </div>
      <!-- 8 · BLOG -->
      <div class="order-8 lg:order-none bento lg:col-span-5 px-5 pt-5 pb-3 flex flex-col group overflow-hidden relative" style="min-height: 242px;">
        <p class="lg:hidden font-mono text-[11px] mb-2 tracking-wide" style="color: var(--muted-foreground);">Blogs</p>
        <div class="w-full aspect-[200/96] rounded-[10px] overflow-hidden relative shrink-0" style="border: 1px solid var(--card-border); background: var(--card-inner);">
          <img src={latestPost.image || "/images/pixel-clouds-blog.jpg"} alt={latestPost.title} class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-500" style="object-position: center 28%;" />
          <div class="absolute top-0 left-0 px-2.5 py-1 rounded-tl-[10px] rounded-br-[8px] flex items-center gap-1.5" style="background: var(--foreground); color: var(--background); font-family: var(--font-mono); font-size: 10px; font-weight: 600; letter-spacing: 0.06em; line-height: 1;"><svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" aria-hidden="true" class="shrink-0" style="display: block; transform: translateY(0.2px);"><path d="M12 2l2.4 7.2H22l-6.2 4.5 2.4 7.3L12 16.9l-6.2 4.1 2.4-7.3L2 9.2h7.6z"/></svg><span style="line-height: 1; display: inline-block; transform: translateY(0.8px);">Latest Blog</span></div>
        </div>
        <div class="space-y-1 mt-4 pr-10">
          <div class="font-mono text-[10px]" style="color: var(--muted-foreground);">{latestPost.date}</div>
          <h4 class="font-medium text-[13px] leading-snug" style="color: var(--foreground); font-family: var(--font-title);">{latestPost.title}</h4>
        </div>
        {/* Functional — opens that post on /blog via hash */}
        <a href={`/blog#${latestPost.id}`} aria-label="Read post" class="absolute bottom-3 right-3 w-7 h-7 rounded-full flex items-center justify-center shrink-0 transition-colors z-10" style="background: color-mix(in srgb, var(--foreground) 82%, var(--background)); border: 1px solid color-mix(in srgb, var(--foreground) 82%, var(--background)); color: var(--background);"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg></a>
      </div>
    </div>

    <!-- 5 · EXPERIENCE — full track from about, mobile only -->
    <section class="order-5 lg:hidden flex flex-col min-w-0" aria-label="Experience">
      <p class="lg:hidden font-mono text-[11px] mb-2 tracking-wide" style="color: var(--muted-foreground);">Experience</p>
      <div class="bento p-4 md:p-5 flex flex-col gap-4">
        <div class="relative pl-5 border-l space-y-1" style="border-color: var(--card-border);">
          <div class="absolute top-1 -left-[4.5px] w-2 h-2 rounded-full" style="background: color-mix(in srgb, var(--muted-foreground) 60%, transparent);"></div>
          <div class="font-mono text-[10px]" style="color: var(--muted-foreground);">2025 — Present</div>
          <h3 class="font-bold text-[13.5px] md:text-[14px] leading-tight" style="color: var(--foreground); font-family: var(--font-sans);">Open Source Contributor</h3>
          <p class="leading-relaxed font-sans text-[11.5px]" style="color: var(--muted-foreground);">Contributing to open-source systems, compilers and reverse-engineering tooling.</p>
          <div class="flex flex-wrap gap-1.5 pt-1">
            <a href="https://github.com/layer5io" target="_blank" rel="noreferrer" class="px-2.5 py-1 rounded-full text-[11px] font-medium border transition-colors" style="border-color: var(--card-border); background: var(--card-inner); color: var(--foreground); font-family: var(--font-mono);">@Layer5</a>
            <a href="https://github.com/llvm" target="_blank" rel="noreferrer" class="px-2.5 py-1 rounded-full text-[11px] font-medium border transition-colors" style="border-color: var(--card-border); background: var(--card-inner); color: var(--foreground); font-family: var(--font-mono);">@LLVM</a>
            <a href="https://github.com/rizinorg" target="_blank" rel="noreferrer" class="px-2.5 py-1 rounded-full text-[11px] font-medium border transition-colors" style="border-color: var(--card-border); background: var(--card-inner); color: var(--foreground); font-family: var(--font-mono);">@Rizin</a>
          </div>
        </div>
        <div class="relative pl-5 border-l space-y-1" style="border-color: var(--card-border);">
          <div class="absolute top-1 -left-[4.5px] w-2 h-2 rounded-full" style="background: color-mix(in srgb, var(--muted-foreground) 60%, transparent);"></div>
          <div class="font-mono text-[10px]" style="color: var(--muted-foreground);">2026 — Present</div>
          <h3 class="font-bold text-[13.5px] md:text-[14px] leading-tight" style="color: var(--foreground); font-family: var(--font-sans);">Head of Research &amp; Development</h3>
          <div class="text-[12px] font-mono" style="color: var(--foreground);">DJS ARYA · DJSCE</div>
          <p class="leading-relaxed font-sans text-[11.5px]" style="color: var(--muted-foreground);">Leading R&amp;D for ARYA, scoping systems and AI projects, mentoring teams, and building tooling around compilers, distributed execution, and security research.</p>
        </div>
        <div class="relative pl-5 border-l space-y-1" style="border-color: var(--card-border);">
          <div class="absolute top-1 -left-[4.5px] w-2 h-2 rounded-full" style="background: color-mix(in srgb, var(--muted-foreground) 60%, transparent);"></div>
          <div class="font-mono text-[10px]" style="color: var(--muted-foreground);">2026 — Present</div>
          <h3 class="font-bold text-[13.5px] md:text-[14px] leading-tight" style="color: var(--foreground); font-family: var(--font-sans);">CTF Player</h3>
          <div class="text-[12px] font-mono" style="color: var(--foreground);">THEM?!</div>
          <p class="leading-relaxed font-sans text-[11.5px]" style="color: var(--muted-foreground);">Competing in international CTFs. Focus on binary exploitation, reverse engineering, and custom VM / heap challenges.</p>
        </div>
        <div class="relative pl-5 border-l space-y-1" style="border-color: var(--card-border);">
          <div class="absolute top-1 -left-[4.5px] w-2 h-2 rounded-full" style="background: color-mix(in srgb, var(--muted-foreground) 60%, transparent);"></div>
          <div class="font-mono text-[10px]" style="color: var(--muted-foreground);">June 2026 — Aug 2026</div>
          <h3 class="font-bold text-[13.5px] md:text-[14px] leading-tight" style="color: var(--foreground); font-family: var(--font-sans);">IT/OT Integration &amp; Cybersecurity Intern</h3>
          <div class="text-[12px] font-mono" style="color: var(--foreground);">Jaajitech</div>
          <p class="leading-relaxed font-sans text-[11.5px]" style="color: var(--muted-foreground);">Conducted VAPT across an ICS/SCADA product suite, focused on the application layer, exposed services, and IT/OT integration points. Documented findings with remediation guidance for the engineering team.</p>
        </div>
      </div>
    </section>

    <!-- Bottom wrapper — contents on phone for global ordering; grid on desktop -->
    <div class="contents lg:grid lg:grid-cols-12 lg:gap-[10px] lg:items-start">
      <!-- left col — contents on phone -->
      <div class="contents lg:flex lg:flex-col lg:gap-[10px] lg:col-span-4 lg:row-span-2">
        <!-- 10 · MAP — compact on phone -->
        <div class="order-10 lg:order-none h-[200px] lg:h-[437px]">
          <MapWidget client:visible />
        </div>
        <!-- 3 · SOCIALS -->
        <div class="order-3 lg:order-none">
          <!-- phone: minimal pill row, keeps bento style -->
          <div class="lg:hidden">
            <h2 class="text-[13px] mb-2" style="color: var(--muted-foreground); font-family: var(--font-sans);">Here are my <span class="font-medium" style="color: var(--foreground);">socials</span></h2>
            <div class="flex flex-wrap gap-1.5">
              <a href="https://github.com/rigalis" target="_blank" rel="noreferrer" class="bento px-3 py-1.5 flex items-center gap-1.5 text-[12px] font-medium transition-colors" style="color: var(--foreground); font-family: var(--font-sans); border-radius: 999px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.73.083-.73 1.205.085 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.108-.775.418-1.305.762-1.605-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.52 11.52 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
                GitHub
              </a>
              <a href="https://x.com/" target="_blank" rel="noreferrer" class="bento px-3 py-1.5 flex items-center gap-1.5 text-[12px] font-medium transition-colors" style="color: var(--foreground); font-family: var(--font-sans); border-radius: 999px;">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.307 0H21.59l-7.03 8.04L23 24h-6.56l-5.14-6.72L5.42 24H2.13l7.52-8.6L1.5 0h6.72l4.64 6.14L18.307 0Zm-1.15 21.57h1.82L6.01 2.3H4.06l13.097 19.27Z"/></svg>
                Twitter / X
              </a>
              <a href="mailto:rigalis.work@gmail.com" class="bento px-3 py-1.5 flex items-center gap-1.5 text-[12px] font-medium transition-colors" style="color: var(--foreground); font-family: var(--font-sans); border-radius: 999px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                Email
              </a>
            </div>
          </div>
          <!-- desktop: original squares, untouched -->
          <div class="hidden lg:grid grid-cols-2 gap-[10px]" style="height: 139px;">
            <a href="https://github.com/rigalis" target="_blank" rel="noreferrer" aria-label="GitHub" class="bento bento-social p-3 flex items-center justify-center transition-all duration-200 group">
              <svg width="42" height="42" viewBox="0 0 24 24" fill="currentColor" class="transition-transform duration-200 group-hover:scale-[1.12]" style="color: var(--foreground);" aria-hidden="true"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.73.083-.73 1.205.085 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.108-.775.418-1.305.762-1.605-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.52 11.52 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
            </a>
            <a href="https://x.com/" target="_blank" rel="noreferrer" aria-label="X" class="bento bento-social p-3 flex items-center justify-center transition-all duration-200 group">
              <svg width="38" height="38" viewBox="0 0 24 24" fill="currentColor" class="transition-transform duration-200 group-hover:scale-[1.12]" style="color: var(--foreground);" aria-hidden="true"><path d="M18.307 0H21.59l-7.03 8.04L23 24h-6.56l-5.14-6.72L5.42 24H2.13l7.52-8.6L1.5 0h6.72l4.64 6.14L18.307 0Zm-1.15 21.57h1.82L6.01 2.3H4.06l13.097 19.27Z"/></svg>
            </a>
          </div>
        </div>
        <!-- NEWS · below socials, mobile only -->
        <div class="order-4 lg:hidden">
          <p class="font-mono text-[11px] mb-2 tracking-wide" style="color: var(--muted-foreground);">Whats New?!</p>
          <div class="bento p-3 flex flex-col relative overflow-hidden" style="background: linear-gradient(180deg, color-mix(in srgb, var(--foreground) 7%, var(--card)), var(--card) 80%);">
            <NewsParticles client:load />
            <div class="relative z-10 space-y-2 font-sans text-[12px] md:text-[12.5px] leading-relaxed" style="font-family: var(--font-sans);">
              <div class="flex justify-between gap-2 font-medium" style="color: var(--foreground);"><span class="flex items-center gap-1.5"><span class="w-1 h-1 rounded-full shrink-0" style="background: var(--foreground);"></span><span><span class="font-mono" style="font-size: 10px; letter-spacing: 0.04em; color: var(--muted-foreground);">[THEM?!]</span> 07CTF&apos;26 2nd Place [Human Div]!</span></span><span style="color: var(--muted-foreground);" class="font-normal">Sep</span></div>
              <div class="flex justify-between gap-2 font-medium" style="color: var(--foreground);"><span class="flex items-center gap-1.5"><span class="w-1 h-1 rounded-full shrink-0" style="background: var(--foreground);"></span><span><span class="font-mono" style="font-size: 10px; letter-spacing: 0.04em; color: var(--muted-foreground);">[THEM?!]</span> Qualified for z0d1ak CTF finals!</span></span><span style="color: var(--muted-foreground);" class="font-normal">Aug</span></div>
              <div class="flex justify-between gap-2 font-medium" style="color: var(--foreground);"><span class="flex items-center gap-1.5"><span class="w-1 h-1 rounded-full shrink-0" style="background: var(--foreground);"></span><span><span class="font-mono" style="font-size: 10px; letter-spacing: 0.04em; color: var(--muted-foreground);">[DJS ARYA]</span> AIR 1, Global Rank 10 @AAS International Cansat Competition!</span></span><span style="color: var(--muted-foreground);" class="font-normal">Jul</span></div>
            </div>
          </div>
        </div>
      </div>
      <!-- 7 · PROJECTS — stacked rows on phone, accordion on desktop -->
      <div class="order-7 lg:order-none lg:col-span-8 flex flex-col min-w-0">
        <p class="lg:hidden font-mono text-[11px] mb-2 tracking-wide" style="color: var(--muted-foreground);">Projects</p>
        <div class="w-full flex flex-col lg:overflow-hidden h-auto lg:h-[288px]">
          <ProjectFlex client:visible />
        </div>
      </div>
      <!-- Row 4 right — placeholder + Spotify (placeholder desktop only) -->
      <div class="order-11 lg:order-none lg:col-span-4 hidden lg:flex flex-col">
        <div class="bento p-5 flex flex-col w-full items-center justify-center" style="height: 288px;">
          <span class="font-mono text-xs tracking-[0.2em]" style="color: var(--muted-foreground);">COMING SOON</span>
        </div>
      </div>
      <!-- 9 · MUSIC — compact row on phone, full tape card on desktop -->
      <div class="order-9 lg:order-none lg:col-span-4 flex flex-col min-w-0">
        <p class="lg:hidden font-mono text-[11px] mb-2 tracking-wide" style="color: var(--muted-foreground);">Music</p>
        <div class="w-full flex flex-col overflow-hidden h-auto lg:h-[288px]">
          <SpotifyWidgets client:visible spotifyUrl="https://open.spotify.com/album/7DQCQeGbnpjr3tF7p3f2jA" />
        </div>
      </div>
    </div>

    <!-- New bottom row — TechStack -->
    <div class="order-12 grid grid-cols-1 gap-[10px] mt-0">
      <TechStack client:visible />
    </div>

    <style>.news-scroll{overflow:hidden;scrollbar-width:none}.news-scroll::-webkit-scrollbar{display:none}</style>
    <script is:inline>
      (function () {
        // Ping-pong auto-scroll for news cards: hold ~3s, glide to the hidden
        // rows, hold ~3s, glide back. Window always fits exactly two full rows.
        function fit(el) {
          var kids = el.children;
          if (!kids || kids.length < 2) return;
          var gap = 8;
          el.style.maxHeight = (kids[0].offsetHeight + kids[1].offsetHeight + gap) + "px";
        }
        function glide(el, to, dur) {
          var from = el.scrollTop;
          var dist = to - from;
          if (dist === 0) return;
          var start = null;
          function frame(ts) {
            if (!document.contains(el)) return;
            if (start === null) start = ts;
            var p = Math.min(1, (ts - start) / dur);
            var e = p < 0.5 ? 2 * p * p : 1 - Math.pow(-2 * p + 2, 2) / 2;
            el.scrollTop = from + dist * e;
            if (p < 1) requestAnimationFrame(frame);
          }
          requestAnimationFrame(frame);
        }
        function setup(el) {
          var atTop = true;
          fit(el);
          // ~3s hold each end, ~1.4s slow glide between
          setInterval(function () {
            if (!document.contains(el)) return;
            fit(el);
            var max = el.scrollHeight - el.clientHeight;
            if (max <= 4) return;
            glide(el, atTop ? max : 0, 1400);
            atTop = !atTop;
          }, 4400);
          window.addEventListener("resize", function () { fit(el); });
        }
        function init() {
          var els = document.querySelectorAll(".news-scroll");
          for (var i = 0; i < els.length; i++) {
            if (!els[i].getAttribute("data-auto")) {
              els[i].setAttribute("data-auto", "1");
              setup(els[i]);
            }
          }
        }
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", init);
        } else {
          init();
        }
      })();
    </script>

  </div>
</Layout>
