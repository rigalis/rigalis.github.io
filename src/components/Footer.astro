---
import { SOCIAL_LINKS } from '@/consts'
---

<footer class="py-6 mt-auto" style="border-top: none; background: transparent;">
  <div
    class="max-w-5xl mx-auto px-4 md:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-[10px]"
    style="color: var(--muted-foreground);"
  >
    <div class="flex gap-4">
      {
        SOCIAL_LINKS.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noreferrer"
            class="hover:opacity-80 transition-colors cursor-pointer" style="color: var(--muted-foreground);"
          >
            {link.label}
          </a>
        ))
      }
    </div>
    <div class="flex flex-col sm:flex-row items-center gap-3 sm:gap-4">
      <a
        href="https://ring.seggs.lol/"
        target="_blank"
        rel="noreferrer noopener"
        aria-label="Visit the Threadlocked webring"
        title="Threadlocked webring"
        class="block shrink-0 opacity-80 hover:opacity-100 transition-opacity"
      >
        <img
          src="/images/threadlocked-badge.svg"
          width="88"
          height="31"
          alt="Threadlocked webring"
          class="block"
          style="image-rendering: pixelated;"
        />
      </a>
      <p class="tracking-tight">
        © {new Date().getFullYear()} rigalis.me. Built with Astro.
      </p>
    </div>
  </div>
</footer>
