---
import { SITE, SOCIAL_LINKS } from '@/consts'
---

<footer class="py-6 mt-auto" style="border-top: none; background: transparent;">
  <div
    class="max-w-5xl mx-auto px-4 md:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-[10px]"
    style="color: var(--muted-foreground);"
  >
    <div class="flex gap-4">
      {
        SOCIAL_LINKS.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noreferrer"
            class="hover:opacity-80 transition-colors cursor-pointer" style="color: var(--muted-foreground);"
          >
            {link.label}
          </a>
        ))
      }
    </div>
    <p class="tracking-tight">
      © {new Date().getFullYear()} {SITE.title}. Built with Astro.
    </p>
  </div>
</footer>
