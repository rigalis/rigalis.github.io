---
import { NAV_LINKS, SITE } from '@/consts'

const pathname = Astro.url.pathname
---

<header
  id="site-header"
  class="sticky top-0 z-50 py-1.5 px-4 md:px-8"
  style="background: var(--nav-bg);"
>
  <div class="max-w-5xl mx-auto flex items-center justify-between">
    <!-- Logo — Parth Patel / rigalis -->
    <a href="/" class="flex flex-col gap-0 leading-none group cursor-pointer select-none">
      <span class="leading-none tracking-tight" style="font-family: var(--font-title); font-size: 14px; font-weight: 700; color: var(--foreground); letter-spacing: -0.02em;">Parth Patel</span>
      <span class="font-mono leading-none" style="font-size: 10px; color: var(--muted-foreground); letter-spacing: 0.06em;">rigalis</span>
    </a>

    <div class="flex items-center gap-1.5">
      <!-- Nav — DM Sans like top bar -->
      <nav class="flex items-center gap-1">
        {
          NAV_LINKS.map((item) => {
            const isActive =
              item.href === '/'
                ? pathname === '/'
                : pathname.startsWith(item.href)
            return (
              <a
                href={item.href}
                style={isActive ? `background: var(--foreground); color: var(--background); font-family: var(--font-title);` : `color: var(--muted-foreground); font-family: var(--font-title);`}
                class={`text-[11px] font-medium px-2 py-1 rounded-none transition-all tracking-tight ${isActive ? '' : 'hover:text-[var(--foreground)]'}`}
              >
                {item.label}
              </a>
            )
          })
        }
      </nav>
      <!-- Theme toggle — small -->
      <button
        id="theme-toggle"
        aria-label="Toggle theme"
        class="w-6 h-6 rounded-none flex items-center justify-center cursor-pointer transition-colors"
        style="background: var(--card-inner); border: 1px solid var(--card-border); color: var(--muted-foreground);"
      >
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/></svg>
      </button>
    </div>
  </div>
</header>
