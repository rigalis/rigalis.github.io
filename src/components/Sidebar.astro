---
import { NAV_LINKS } from '@/consts'
const pathname = Astro.url.pathname
---

<aside id="app-sidebar" class="hidden lg:flex flex-col w-[180px] shrink-0 sticky top-0 h-screen py-6 pl-1 pr-2 overflow-hidden" style="background: transparent;">
  <!-- Logo — Parth Patel / rigalis -->
  <a href="/" class="flex flex-col gap-0.5 mb-8 group">
    <span class="leading-none tracking-tight" style="font-family: var(--font-title); font-size: 16px; font-weight: 700; color: var(--foreground); letter-spacing: -0.02em;">Parth Patel</span>
    <span class="font-mono leading-none" style="font-size: 11px; color: var(--muted-foreground); letter-spacing: 0.06em;">rigalis</span>
  </a>

  <!-- Nav — vertical like enscribe -->
  <nav class="flex flex-col gap-1">
    {NAV_LINKS.map((item) => {
      const isActive = item.href === '/' ? pathname === '/' : pathname.startsWith(item.href)
      return (
        <a
          href={item.href}
          class={`text-[13px] font-medium px-3 py-1.5 rounded-[6px] transition-colors ${isActive ? 'bg-[var(--foreground)] text-[var(--background)]' : 'text-[var(--muted-foreground)] hover:text-[var(--foreground)] hover:bg-[var(--card-inner)]'}`}
          style="font-family: var(--font-sans);"
        >
          {item.label}
        </a>
      )
    })}
  </nav>

  <!-- Deep Dive TOC — uncompressed -->
  <div id="deepdive-sidebar-block" class="hidden flex-col gap-0 mt-6 pt-6 flex-1 min-h-0 pr-1 overflow-y-auto" style="border-top: 1px solid var(--card-border);">
    <div class="flex items-start min-h-0">
      <!-- TOC — always expanded -->
      <div class="flex-1 min-w-0">
        <div class="text-[10px] tracking-[0.12em] font-semibold mb-2 shrink-0" style="color: var(--muted-foreground); font-family: var(--font-mono);">ON THIS PAGE</div>
        <nav id="sidebar-toc-nav" class="space-y-0.5 border-l pl-3 shrink-0" style="border-color: color-mix(in srgb, var(--card-border) 70%, transparent);">
          <a href="#introduction" data-toc-id="introduction" class="block py-1 text-[12px] leading-4 transition-colors border-l -ml-[13px] pl-3 font-medium" style="padding-left: 12px; color: var(--foreground); border-color: var(--foreground); border-left-width: 1.5px; font-family: var(--font-sans);">Introduction</a>
          <a href="#anatomy-heap-chunk" data-toc-id="anatomy-heap-chunk" class="block py-1 text-[12px] leading-4 transition-colors border-l -ml-[13px] pl-3" style="padding-left: 12px; color: var(--muted-foreground); border-color: transparent; border-left-width: 1.5px; font-family: var(--font-sans);">Anatomy of a Heap Chunk</a>
          <a href="#chunk-flags" data-toc-id="chunk-flags" class="block py-1 text-[11px] leading-4 transition-colors border-l -ml-[13px] pl-3" style="padding-left: 18px; color: var(--muted-foreground); border-color: transparent; border-left-width: 1.5px; font-family: var(--font-sans);">Chunk flags — AMP bits</a>
          <a href="#double-free" data-toc-id="double-free" class="block py-1 text-[12px] leading-4 transition-colors border-l -ml-[13px] pl-3" style="padding-left: 12px; color: var(--muted-foreground); border-color: transparent; border-left-width: 1.5px; font-family: var(--font-sans);">The Double-Free Vulnerability</a>
          <a href="#example-vulnerability" data-toc-id="example-vulnerability" class="block py-1 text-[11px] leading-4 transition-colors border-l -ml-[13px] pl-3" style="padding-left: 18px; color: var(--muted-foreground); border-color: transparent; border-left-width: 1.5px; font-family: var(--font-sans);">Example: vulnerable C</a>
          <a href="#tcache-hardening" data-toc-id="tcache-hardening" class="block py-1 text-[12px] leading-4 transition-colors border-l -ml-[13px] pl-3" style="padding-left: 12px; color: var(--muted-foreground); border-color: transparent; border-left-width: 1.5px; font-family: var(--font-sans);">tcache &amp; Modern Hardening</a>
          <a href="#recall" data-toc-id="recall" class="block py-1 text-[11px] leading-4 transition-colors border-l -ml-[13px] pl-3" style="padding-left: 18px; color: var(--muted-foreground); border-color: transparent; border-left-width: 1.5px; font-family: var(--font-sans);">Recall</a>
          <a href="#exploitation-lab" data-toc-id="exploitation-lab" class="block py-1 text-[12px] leading-4 transition-colors border-l -ml-[13px] pl-3" style="padding-left: 12px; color: var(--muted-foreground); border-color: transparent; border-left-width: 1.5px; font-family: var(--font-sans);">Exploitation Lab</a>
          <a href="#visualising-corruption" data-toc-id="visualising-corruption" class="block py-1 text-[11px] leading-4 transition-colors border-l -ml-[13px] pl-3" style="padding-left: 18px; color: var(--muted-foreground); border-color: transparent; border-left-width: 1.5px; font-family: var(--font-sans);">Visualising Corruption</a>
          <a href="#mitigations-fixes" data-toc-id="mitigations-fixes" class="block py-1 text-[12px] leading-4 transition-colors border-l -ml-[13px] pl-3" style="padding-left: 12px; color: var(--muted-foreground); border-color: transparent; border-left-width: 1.5px; font-family: var(--font-sans);">Mitigations &amp; Fixes</a>
          <a href="#footnotes" data-toc-id="footnotes" class="block py-1 text-[12px] leading-4 transition-colors border-l -ml-[13px] pl-3" style="padding-left: 12px; color: var(--muted-foreground); border-color: transparent; border-left-width: 1.5px; font-family: var(--font-sans);">Footnotes</a>
        </nav>
      </div>
    </div>
  </div>

  <!-- Bottom actions — search / theme / justification -->
  <div class="mt-auto flex flex-col gap-2 pt-6 shrink-0" style="border-top: 1px solid var(--card-border);">
    <button id="sidebar-search" class="flex items-center gap-2 w-full px-3 py-2 rounded-[6px] text-[13px] text-[var(--muted-foreground)] hover:text-[var(--foreground)] hover:bg-[var(--card-inner)] border border-[var(--card-border)] transition-colors" style="font-family: var(--font-sans);">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      <span>Search</span>
      <span class="ml-auto text-[10px] font-mono opacity-50">/</span>
    </button>
    <div class="flex items-center gap-2">
      <button id="sidebar-theme" aria-label="Toggle theme" class="flex-1 flex items-center justify-center gap-1.5 px-3 py-2 rounded-[6px] border border-[var(--card-border)] bg-[var(--card-inner)] text-[var(--muted-foreground)] hover:text-[var(--foreground)] transition-colors" style="font-family: var(--font-mono); font-size: 12px;">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/></svg>
        Theme
      </button>
      <button id="sidebar-justify" aria-pressed="false" title="Toggle justification" class="w-9 h-9 flex items-center justify-center rounded-[6px] border border-[var(--card-border)] bg-[var(--card-inner)] text-[var(--muted-foreground)] hover:text-[var(--foreground)] transition-colors">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
    </div>
  </div>
</aside>

<!-- Search modal — enscribe style -->
<dialog id="search-dialog" class="p-0 bg-transparent backdrop:bg-black/60 open:flex items-center justify-center w-full max-w-xl mx-auto mt-[20vh] border-0">
  <div class="w-full bg-[var(--card)] border border-[var(--card-border)] rounded-[12px] overflow-hidden shadow-xl">
    <div class="flex items-center gap-3 px-4 py-3 border-b border-[var(--card-border)]">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="text-[var(--muted-foreground)]"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      <input id="search-input" placeholder="Type to search..." class="flex-1 bg-transparent outline-none text-[14px] text-[var(--foreground)] placeholder:text-[var(--muted-foreground)]" style="font-family: var(--font-sans);" autofocus />
      <span class="text-[10px] font-mono px-1.5 py-0.5 rounded border border-[var(--card-border)] text-[var(--muted-foreground)]">ESC</span>
    </div>
    <div id="search-results" class="max-h-[320px] overflow-auto p-2 text-[13px]" style="font-family: var(--font-sans); color: var(--muted-foreground);">Type to search blog, work, pages…</div>
  </div>
</dialog>

<script is:inline>
  (function(){
    const dlg = document.getElementById('search-dialog');
    const input = document.getElementById('search-input');
    const results = document.getElementById('search-results');
    const btn = document.getElementById('sidebar-search');
    const justifyBtn = document.getElementById('sidebar-justify');
    const themeBtn = document.getElementById('sidebar-theme');
    if (btn && dlg) {
      btn.addEventListener('click', () => { dlg.showModal(); input?.focus(); });
      // open with /
      document.addEventListener('keydown', (e) => {
        if (e.key === '/' && !dlg.open && document.activeElement?.tagName !== 'INPUT') { e.preventDefault(); dlg.showModal(); input?.focus(); }
        if (e.key === 'Escape' && dlg.open) dlg.close();
      });
      dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    }
    if (themeBtn) themeBtn.addEventListener('click', () => window.__toggleTheme && window.__toggleTheme());
    if (justifyBtn) {
      justifyBtn.addEventListener('click', () => {
        const pressed = justifyBtn.getAttribute('aria-pressed') === 'true';
        justifyBtn.setAttribute('aria-pressed', String(!pressed));
        document.body.style.textAlign = !pressed ? 'justify' : '';
        justifyBtn.style.color = !pressed ? 'var(--foreground)' : 'var(--muted-foreground)';
      });
    }
    if (input && results) {
      const pages = [
        {label:'Home', href:'/'}, {label:'Blog', href:'/blog'}, {label:'Work', href:'/work'}, {label:'About', href:'/about'},
        {label:'Inferno - Binary Analysis', href:'/blog'}, {label:'Heap Overflows', href:'/blog'},
      ];
      input.addEventListener('input', () => {
        const q = input.value.toLowerCase();
        const filtered = pages.filter(p => p.label.toLowerCase().includes(q));
        results.innerHTML = filtered.length ? filtered.map(p => `<a href="${p.href}" class="flex items-center justify-between px-3 py-2 rounded-[6px] hover:bg-[var(--card-inner)] text-[var(--foreground)]"><span>${p.label}</span><span class="text-[11px] font-mono text-[var(--muted-foreground)]">${p.href}</span></a>`).join('') : '<div class="px-3 py-6 text-center">No results</div>';
        if (!q) results.innerHTML = '<div class="px-3 py-2">Type to search blog, work, pages…</div>';
      });
    }
    // Deep dive TOC smooth scroll
    const tocNav = document.getElementById('sidebar-toc-nav');
    if (tocNav) {
      tocNav.addEventListener('click', (e) => {
        const a = (e.target instanceof Element ? e.target.closest('a') : null) as HTMLAnchorElement | null;
        if (!a) return;
        const href = a.getAttribute('href');
        if (!href || !href.startsWith('#')) return;
        e.preventDefault();
        const id = href.slice(1);
        const el = document.getElementById(id);
        if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        history.replaceState(null, '', `#${id}`);
      });
    }
  })();
</script>
